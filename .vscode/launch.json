{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run Go and React",
      "configurations": ["Go Server", "React App"]
    }
  ],
  "configurations": [
    {
      "name": "Go Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/."
    },
    {
      "name": "React App",
      "type": "pwa-node",
      "request": "launch",
      "name": "React App",
      "cwd": "${workspaceFolder}/client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "console": "integratedTerminal"
    }
  ]
}
